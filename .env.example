# --- core ---
PORT=8090
NXTGEN_TICK_SECONDS=2.0          # bot engine + price feed tick interval, seconds

# --- database (Phase 1 ships on SQLite; see README for the Postgres swap) ---
# Where the SQLite file lives. Leave unset for local dev (defaults next to
# the app). On a host with a persistent disk (e.g. Render), point this at
# the mounted path so data survives restarts/redeploys — e.g. /data/nxtgen.db
NXTGEN_DB_PATH=

# --- security ---
SECRET_KEY=change-me-to-a-long-random-string
CREDENTIAL_ENCRYPTION_KEY=change-me-32-byte-base64-key     # for encrypting broker_credentials at rest

# --- live broker adapters (all unset by default; adapters clearly error until configured) ---
DERIV_APP_ID=
DERIV_API_TOKEN=
MT5_BRIDGE_URL=                  # e.g. https://mt5-bridge.internal:8443
MT5_BRIDGE_SHARED_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- integration with the existing NxTGen DeCrypt app (kept independent for now) ---
NXTGEN_DECRYPT_BASE_URL=https://nxtgendecrypt.site
NXTGEN_DECRYPT_SHARED_AUTH_SECRET=
